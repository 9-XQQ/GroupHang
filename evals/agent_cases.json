{
  "version": "1.0",
  "description": "Public synthetic cases; assistant proposal evaluation only, never executes database writes.",
  "default_context": {
    "trip": {
      "title": "公开合成演示行程",
      "status": "active",
      "primary_workflow": "itinerary",
      "planned_start_at": "2026-11-01T13:00:00+08:00",
      "planned_end_at": "2026-11-01T18:00:00+08:00",
      "group_transport_mode": "transit",
      "optimization_objective": "balanced",
      "input_version": 1
    },
    "participants": [
      {
        "name": "演示甲",
        "role": "creator",
        "has_start_location": true
      }
    ],
    "destinations": [
      {
        "id": 101,
        "name": "演示博物馆",
        "visit_status": "must_visit",
        "expected_stay_min": 60
      },
      {
        "id": 102,
        "name": "演示公园",
        "visit_status": "must_visit",
        "expected_stay_min": 30
