      "category": "planning",
      "kind": "rules",
      "message": "请生成当前路线",
      "expected": {
        "actions": [
          {
            "type": "generate_itinerary"
          }
        ]
      }
    },
    {
      "id": "route_compare",
      "category": "planning",
      "kind": "rules",
      "message": "比较不同路线方案",
      "expected": {
        "actions": [
          {
            "type": "compare_itineraries"
          }
        ]
      }
    },
    {
      "id": "switch_meeting",
      "category": "planning",
      "kind": "rules",
      "message": "切换主方案为共同约点",
      "expected": {
        "actions": [
          {
            "type": "switch_workflow",
