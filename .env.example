# =====================================================
# 出行规划 Agent - 环境变量示例
# 复制本文件为 .env 并填入真实值：
#   cp .env.example .env
# =====================================================

# ---- 高德地图开放平台 ----
# 到 https://lbs.amap.com 注册开发者，创建「Web服务」类型应用，获取 Key
AMAP_API_KEY=your_amap_web_service_key
AMAP_BASE_URL=https://restapi.amap.com

# ---- 高德 JS API（前端地图显示用，与上方 Web服务 Key 是两种不同类型）----
# 到高德控制台创建「Web端(JS API)」应用获取 Key 与 securityJsCode，并把 localhost 加入域名白名单
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=

# ---- 可选 LLM 地点解析（默认关闭，不配置也可完整使用规则解析）----
# 支持 OpenAI-compatible Chat Completions 服务；不要把真实 Key 提交到 Git。
LLM_API_KEY=
# OpenAI-compatible 示例：https://api.openai.com/v1
# Anthropic-compatible 示例：https://api.deepseek.com/anthropic（代码按 /anthropic 自动识别协议）
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

# ---- 数据库 ----
# PostgreSQL 连接串（使用 asyncpg 驱动）
#DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/

# ---- 服务配置 ----
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ---- 手机验证码登录 ----
# 至少32个随机字符；使用本地环境变量配置，不要提交真实值。
AUTH_SECRET=
# disabled 默认关闭；mock 仅允许 APP_ENV=development，不发送真实短信。
SMS_PROVIDER=disabled
AUTH_SESSION_DAYS=7
# 生产必须 true，并使用 HTTPS
AUTH_COOKIE_SECURE=false
# 同源前端无需填写；额外来源必须精确列出，不允许通配符
CORS_ORIGINS=[]

# ---- 阿里云国内短信：资质/签名/模板通过后再开启 ----
# SMS_PROVIDER=aliyun
ALIYUN_SMS_ENABLED=false
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_CODE_PARAMETER=code
ALIYUN_SMS_TIMEOUT_SECONDS=8
