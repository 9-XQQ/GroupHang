# =====================================================
# 出行规划 Agent - 环境变量示例
# 复制本文件为 .env 并填入真实值：
#   cp .env.example .env
# =====================================================

# ---- 高德地图开放平台 ----
# 到 https://lbs.amap.com 注册开发者，创建「Web服务」类型应用，获取 Key
AMAP_API_KEY=your_amap_web_service_key
AMAP_BASE_URL=https://restapi.amap.com

# ---- 高德 JS API（前端地图显示用，与上方 Web服务 Key 是两种不同类型）----
# 到高德控制台创建「Web端(JS API)」应用获取 Key 与 securityJsCode，并把 localhost 加入域名白名单
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=

# ---- 数据库 ----
# PostgreSQL 连接串（使用 asyncpg 驱动）
#DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/trip_planner
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trip_planner

# ---- 服务配置 ----
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
